---
import geometry from '../../data/miclustering/geometry.json';
interface Props { locale: 'es' | 'en' }
const { locale } = Astro.props;
const es = locale === 'es';
const models = ['MIDBSCAN', 'MIKMeans', 'MIKMedoids', 'COSMIC'];
const labels: Record<string, string> = {
  'BirdsChestnut-backedChickadee': 'Birds Chestnut',
  BirdsHammondsFlycatcher: 'Birds Hammonds',
  Harddrive1: 'Harddrive 1',
  ImageElephant: 'Image Elephant',
  Newsgroups1: 'Newsgroups 1',
  Thioredoxin: 'Thioredoxin',
  musk1: 'Musk 1',
  musk2: 'Musk 2',
  mutagenesis3_atoms: es ? 'Mutagénesis 3 átomos' : 'Mutagenesis 3 atoms',
  mutagenesis3_chains: es ? 'Mutagénesis 3 cadenas' : 'Mutagenesis 3 chains',
};
// Discrete samples of Matplotlib's YlOrRd palette, with explicit text contrast.
const colors = ['#ffffcc', '#ffeda0', '#fed976', '#feb24c', '#fd8d3c', '#fc4e2a', '#e31a1c', '#bd0026', '#800026'];
const color = (value: number) => colors[Math.min(colors.length - 1, Math.max(0, Math.floor(value * colors.length)))];
const metricPanels = [
  { id: 'score', name: 'CVI score', subtitle: es ? 'Puntuación geométrica máxima' : 'Maximum geometric score', values: geometry.metrics.score },
  { id: 'f1', name: 'F1-score', subtitle: es ? 'F1 externo máximo' : 'Maximum external F1-score', values: geometry.metrics.f1_score },
];
---
<div class="explorer">
  <div class="explorer-head"><div><span>{es ? 'ESTUDIO EXPLORATORIO / SEPTIEMBRE DE 2026' : 'EXPLORATORY STUDY / SEPTEMBER 2026'}</span><h3>{es ? 'Resultados por conjunto de datos' : 'Results across datasets'}</h3></div><p>{es ? '10 conjuntos' : '10 datasets'} <span>·</span> {es ? '4 modelos' : '4 models'}</p></div>
  <p class="chart-intro">{es ? 'Compara la puntuación máxima registrada para cada conjunto y modelo entre los escaladores y distancias evaluados.' : 'Compare the highest score recorded for each dataset and model across the evaluated scalers and distances.'}</p>
  <input class="metric-input" type="radio" name="geometry-metric" id="metric-score" checked />
  <input class="metric-input" type="radio" name="geometry-metric" id="metric-f1" />
  <div class="metric-controls" role="group" aria-label={es ? 'Seleccionar una métrica' : 'Choose a metric'}>
    <span>{es ? 'MÉTRICA' : 'METRIC'}</span><label for="metric-score">{es ? 'Puntuación CVI' : 'CVI score'}</label><label for="metric-f1">F1-score</label>
  </div>
  {metricPanels.map(panel => (
    <div class:list={['metric-panel', `panel-${panel.id}`]}>
      <div class="chart-title"><strong>{panel.subtitle}</strong><span>{es ? 'MAYOR ES MEJOR' : 'HIGHER IS BETTER'}</span></div>
      <div class="heatmap-scroll" tabindex="0" role="region" aria-label={es ? `${panel.subtitle}; desplázate horizontalmente para ver todos los modelos` : `${panel.subtitle}; scroll horizontally to see all models`}>
        <table class="heatmap">
          <caption class="sr-only">{es ? `${panel.subtitle} por conjunto y modelo. Valores máximos entre escaladores y distancias.` : `${panel.subtitle} by dataset and model. Values are maxima across scalers and distances.`}</caption>
          <thead><tr><th scope="col">{es ? 'Conjunto' : 'Dataset'}</th>{models.map(model => <th scope="col">{model}</th>)}</tr></thead>
          <tbody>{geometry.datasets.map((dataset, row) => (
            <tr><th scope="row" title={dataset}>{labels[dataset] ?? dataset}</th>{panel.values[row].map(value => (
              <td style={`--cell:${color(value)};--cell-ink:${value >= 6 / 9 ? '#ffffff' : '#21140f'}`}><span>{value.toFixed(3)}</span></td>
            ))}</tr>
          ))}</tbody>
        </table>
      </div>
      <div class="legend"><span>0.0</span><div aria-hidden="true"></div><span>1.0</span></div>
      <p class="chart-note">{panel.id === 'score' ? (es ? 'Puntuación CVI = 0.5 × silhouette + 0.5 × Dunn normalizado. El ruido se excluye de los índices internos.' : 'CVI score = 0.5 × silhouette + 0.5 × normalized Dunn. Noise is excluded from the internal indices.') : (es ? 'F1 usa etiquetas externas tras la asignación húngara de clústeres a clases. Es una comparación exploratoria, no una evaluación sobre datos reservados.' : 'F1 uses external labels after Hungarian cluster-to-class mapping. It is an exploratory comparison, not a held-out test score.')}</p>
    </div>
  ))}
  <p class="chart-caption"><strong>{es ? 'Figura 2.' : 'Figure 2.'}</strong> {es ? 'Máximos independientes entre los ensayos seleccionados de 480 estudios. Los máximos de CVI y F1 de una celda pueden proceder de configuraciones diferentes. Los valores se redondean para su presentación.' : 'Independent maxima among selected trials from 480 studies. The CVI and F1 maxima for a cell can come from different configurations. Values are rounded for display.'} <a href="/miclustering/experiments/resultados_combinados.csv">{es ? 'Descargar los datos por estudio (CSV)' : 'Download the study-level data (CSV)'}</a>.</p>
</div>
<style>
  .explorer { margin: 2rem 0; padding: 1.5rem; border-radius: 4px; background: var(--panel-high); color: var(--ink); }
  .explorer-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .explorer-head span, .metric-controls > span, .chart-title span { color: var(--sage); font: 600 .75rem/1.4 var(--report-sans); letter-spacing: .05em; }
  .explorer-head h3 { margin-top: .35rem; font: 600 1.5rem/1.25 var(--report-serif); }
  .explorer-head p { color: var(--muted); font: .8125rem var(--report-mono); white-space: nowrap; }
  .chart-intro { margin: 1rem 0; color: var(--muted); font-size: .9375rem; line-height: 1.6; }
  .metric-input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .metric-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; margin: 1rem 0 1.5rem; border-bottom: 1px solid var(--line); }
  .metric-controls > span { margin-right: .5rem; }
  .metric-controls label { padding: .65rem .75rem; border-bottom: 2px solid transparent; cursor: pointer; color: var(--muted); font: 600 .8125rem var(--report-sans); transition: color 120ms ease-out, border-color 120ms ease-out; }
  .metric-controls label:hover { color: var(--accent); }
  #metric-score:checked ~ .metric-controls label[for='metric-score'], #metric-f1:checked ~ .metric-controls label[for='metric-f1'] { border-color: var(--accent); color: var(--accent); }
  #metric-score:focus-visible ~ .metric-controls label[for='metric-score'], #metric-f1:focus-visible ~ .metric-controls label[for='metric-f1'] { outline: 2px solid var(--accent); outline-offset: 2px; }
  #metric-score:checked ~ .panel-f1, #metric-f1:checked ~ .panel-score { display: none; }
  .chart-title { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .75rem; font-size: 1rem; }
  .heatmap-scroll { overflow-x: auto; }
  .heatmap-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .heatmap { width: 100%; min-width: 590px; border-collapse: separate; border-spacing: 3px; font: .8125rem/1.2 var(--report-mono); }
  .heatmap th { text-align: center; font-weight: 500; }
  .heatmap thead th { padding: .4rem .2rem; color: var(--muted); }
  .heatmap th:first-child { width: 30%; text-align: left; }
  .heatmap tbody th { padding-right: .4rem; color: var(--ink); font-size: .75rem; }
  .heatmap td { padding: .7rem .2rem; background: var(--cell); color: var(--cell-ink); text-align: center; font-variant-numeric: tabular-nums; }
  .legend { display: flex; justify-content: flex-end; align-items: center; gap: .5rem; margin-top: .9rem; color: var(--muted); font: .75rem var(--report-mono); }
  .legend div { width: 130px; height: 8px; background: linear-gradient(to right,#ffffcc,#fed976,#fd8d3c,#e31a1c,#800026); }
  .chart-note, .chart-caption { margin-top: 1rem; color: var(--muted); font-size: .875rem; line-height: 1.6; }
  .chart-caption { padding-top: 1rem; border-top: 1px solid var(--line); }
  .chart-caption a { color: var(--accent); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width:600px) { .explorer { padding: 1rem; margin-inline: -.2rem; } .explorer-head { display: block; } .explorer-head p { margin-top: .6rem; } .chart-title { display: block; } .chart-title span { display: block; margin-top: .3rem; } }
  @media (prefers-reduced-motion: reduce) { .metric-controls label { transition: none; } }
  @media print { .metric-panel { display: block !important; } .metric-controls { display: none; } .heatmap-scroll { overflow: visible; } .heatmap { min-width: 0; } }
</style>
