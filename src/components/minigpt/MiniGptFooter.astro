---
// src/components/minigpt/MiniGptFooter.astro
interface Props {
  currentLocale: 'es' | 'en';
}

const { currentLocale } = Astro.props;
---

<footer class="minigpt-footer"><div class="minigpt-footer__inner"><span>{currentLocale === 'en' ? 'Educational project · No public deployment' : 'Proyecto educativo · Sin despliegue público'}</span><a href={currentLocale === 'en' ? '/en' : '/'}>{currentLocale === 'en' ? 'Back to portfolio' : 'Volver al portfolio'} ↗</a></div></footer>

<style>
  .minigpt-footer {
    width: 100%;
    padding: var(--minigpt-space-2) var(--minigpt-space-4);
    background: var(--minigpt-glass-surface);
    backdrop-filter: var(--minigpt-glass-blur);
    -webkit-backdrop-filter: var(--minigpt-glass-blur);
    border-top: 1px solid var(--minigpt-border-subtle);
    font-size: var(--minigpt-font-xs);
    color: var(--minigpt-text-tertiary);
    z-index: 30;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .minigpt-footer {
      background: var(--minigpt-bg-secondary);
    }
  }

  .minigpt-footer__inner {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--minigpt-space-3);
    flex-wrap: wrap;
  }

  .minigpt-footer__inner a {
    color: var(--minigpt-text-secondary);
    text-decoration: none;
  }

  .minigpt-footer__inner a:hover {
    color: var(--minigpt-accent);
  }

  @media (max-width: 540px) {
    .minigpt-footer__inner {
      gap: var(--minigpt-space-2);
      justify-content: space-between;
    }
  }
</style>
