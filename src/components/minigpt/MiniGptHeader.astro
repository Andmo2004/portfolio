---
// src/components/minigpt/MiniGptHeader.astro


interface Props {
  currentLocale: 'es' | 'en';
  activeTab?: 'chat' | 'training' | 'architecture' | 'experiments';
}

const { currentLocale, activeTab = 'chat' } = Astro.props;

const homeHref = currentLocale === 'en' ? '/en' : '/';
const basePath = currentLocale === 'en' ? '/en/projects/minigpt' : '/projects/minigpt';
const otherLocaleBase = currentLocale === 'en' ? '/projects/minigpt' : '/en/projects/minigpt';

// Destino del selector de idioma conservando la pestaña activa
const langSwitchTarget = `${otherLocaleBase}/${activeTab}`;
const langSwitchLabel = currentLocale === 'en' ? 'ES' : 'EN';

const tabs = [
  { id: 'chat', label: 'Chat' },
  { id: 'training', label: 'Training' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'experiments', label: 'Experiments' },
];

const activeTabIndex = Math.max(0, tabs.findIndex((t) => t.id === activeTab));
---

<header class="minigpt-header">
  <div class="minigpt-header__left">
    <button
      type="button"
      id="btn-open-sidebar"
      class="minigpt-icon-btn"
      title={currentLocale === 'en' ? 'Model architecture & parameters' : 'Arquitectura y parámetros del modelo'}
      aria-label={currentLocale === 'en' ? 'Open model parameters' : 'Abrir parámetros del modelo'}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="6" y2="6"/>
        <line x1="4" x2="20" y1="12" y2="12"/>
        <line x1="4" x2="20" y1="18" y2="18"/>
      </svg>
    </button>

    <div class="minigpt-header__brand">
      <a href={`${basePath}/chat`} class="minigpt-header__logo-link">
        <span class="minigpt-header__logo">miniGPT</span>
      </a>
      <span class="minigpt-header__subtitle">
        {currentLocale === 'en' ? 'Small language model built from scratch' : 'Modelo de lenguaje autoregresivo construido desde cero'}
      </span>
    </div>
  </div>

  <!-- Segmented Control con estilo pulido y thumb deslizante -->
  <div class="minigpt-header__center">
    <div class="segmented" style={`--count: ${tabs.length}`}>
      {tabs.map((tab) => (
        <a
          href={`${basePath}/${tab.id}`}
          class:list={['seg', { 'is-active': activeTab === tab.id }]}
          data-tab={tab.id}
        >
          {tab.label}
        </a>
      ))}
      <div class="seg-thumb" style={`transform: translateX(${activeTabIndex * 100}%);`}></div>
    </div>
  </div>

  <!-- Controles y Enlaces de la Cabecera (Fuentes, Tamaños y Alturas Uniformes) -->
  <div class="minigpt-header__right">
    <nav class="minigpt-header__nav" aria-label="Navegación externa">
      <a href={homeHref} class="header-nav-item">
        <span>Portfolio</span>
        <span class="header-nav-arrow" aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/Andmo2004" target="_blank" rel="noopener noreferrer" class="header-nav-item">
        <span>GitHub</span>
        <span class="header-nav-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="minigpt-header__controls">
      <a
        href={langSwitchTarget}
        class="header-lang-toggle"
        title={currentLocale === 'en' ? 'Cambiar a Español' : 'Switch to English'}
      >
        <span class="header-bracket">[</span>
        <span class="header-lang-code">{langSwitchLabel}</span>
        <span class="header-bracket">]</span>
      </a>



      <!-- Theme Switcher -->
      <button
        type="button"
        id="btn-theme-toggle"
        class="minigpt-icon-btn"
        title={currentLocale === 'en' ? 'Toggle theme' : 'Cambiar tema claro/oscuro'}
        aria-label={currentLocale === 'en' ? 'Toggle theme' : 'Cambiar tema claro/oscuro'}
      >
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/>
          <path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/>
          <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const themeBtn = document.getElementById('btn-theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('minigpt_theme', nextTheme);
    });
  }

  // Segmented control — animate thumb before navigating
  (function () {
    const segmented = document.querySelector('.segmented');
    if (!segmented) return;

    const segs = Array.from(segmented.querySelectorAll('.seg'));
    const thumb = segmented.querySelector('.seg-thumb');
    if (!thumb || segs.length === 0) return;

    let isAnimating = false;

    segs.forEach((seg, targetIndex) => {
      seg.addEventListener('click', (e) => {
        // Skip if already on this tab or mid-animation
        if (seg.classList.contains('is-active') || isAnimating) return;

        e.preventDefault();
        isAnimating = true;
        const href = seg.getAttribute('href');

        // Move thumb to target position
        thumb.style.transform = 'translateX(' + (targetIndex * 100) + '%)';

        // Update active states immediately for visual feedback
        segs.forEach((s) => s.classList.remove('is-active'));
        seg.classList.add('is-active');

        // Navigate after animation completes
        setTimeout(() => {
          if (href) window.location.href = href;
        }, 280);
      });
    });
  })();
</script>

<style>
  /* CABECERA CON GLASSMORPHISM PESADO */
  .minigpt-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--minigpt-space-4);
    padding: 0.65rem var(--minigpt-space-5);
    background: var(--minigpt-header-bg);
    backdrop-filter: var(--minigpt-glass-blur);
    -webkit-backdrop-filter: var(--minigpt-glass-blur);
    border-bottom: 1px solid var(--minigpt-glass-border);
    box-shadow: var(--minigpt-glass-shadow);
    transition: background-color var(--minigpt-duration-base) var(--minigpt-ease),
                border-color var(--minigpt-duration-base) var(--minigpt-ease);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .minigpt-header {
      background: var(--minigpt-bg-secondary);
    }
  }

  .minigpt-header__left {
    display: flex;
    align-items: center;
    gap: var(--minigpt-space-3);
    flex-shrink: 0;
  }

  .minigpt-header__brand {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* LOGO MINIGPT: Fuente Caveat, sin subrayados ni morados */
  .minigpt-header__logo-link,
  .minigpt-header__logo-link:visited,
  .minigpt-header__logo-link:hover,
  .minigpt-header__logo-link:active {
    display: inline-flex;
    align-items: baseline;
    gap: var(--minigpt-space-2);
    text-decoration: none !important;
    color: var(--minigpt-text-primary) !important;
    outline: none;
    border: none;
  }

  .minigpt-header__logo {
    font-family: var(--minigpt-font-handwriting);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    color: var(--minigpt-text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }



  .minigpt-header__subtitle {
    font-family: var(--minigpt-font-sans);
    font-size: 0.6875rem;
    color: var(--minigpt-text-secondary);
    line-height: var(--minigpt-line-tight);
    white-space: nowrap;
  }

  /* SEGMENTED CONTROL — centrado absoluto */
  .minigpt-header__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 32rem;
    width: max-content;
  }

  .segmented {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    gap: 2px;
    padding: 3px;
    background: var(--minigpt-glass-surface);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-radius: var(--minigpt-radius-pill);
    border: 1px solid var(--minigpt-glass-border);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    width: 100%;
  }

  .seg {
    position: relative;
    z-index: 1;
    padding: 0.35rem var(--minigpt-space-3);
    border: none;
    background: transparent;
    border-radius: var(--minigpt-radius-pill);
    font-family: var(--minigpt-font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--minigpt-text-secondary);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .seg.is-active {
    color: var(--minigpt-text-primary);
    font-weight: 600;
  }

  .seg-thumb {
    position: absolute;
    inset: 3px auto 3px 3px;
    width: calc((100% - 6px) / var(--count));
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--minigpt-radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    transition: transform var(--minigpt-duration-base) var(--minigpt-ease);
    pointer-events: none;
  }

  :global([data-theme="dark"]) .seg-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .seg-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    }
  }

  .seg:hover {
    color: var(--minigpt-text-primary);
  }

  .seg:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  /* CONTROLES DERECHOS: UNIFORMIDAD TIPOGRÁFICA Y DE TAMAÑOS */
  .minigpt-header__right {
    display: flex;
    align-items: center;
    gap: var(--minigpt-space-3);
    flex-shrink: 0;
  }

  .minigpt-header__nav {
    display: flex;
    align-items: center;
    gap: var(--minigpt-space-3);
  }

  .header-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--minigpt-font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--minigpt-text-secondary);
    text-decoration: none;
    transition: color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .header-nav-item:hover,
  .header-nav-item:focus-visible {
    color: var(--minigpt-text-primary);
  }

  .header-nav-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
    transition: transform var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .header-nav-item:hover .header-nav-arrow {
    transform: translate(1px, -1px);
    opacity: 1;
  }

  .minigpt-header__controls {
    display: flex;
    align-items: center;
    gap: var(--minigpt-space-3);
  }

  .header-lang-toggle {
    display: inline-flex;
    align-items: center;
    font-family: var(--minigpt-font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--minigpt-text-secondary);
    text-decoration: none;
    transition: color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .header-bracket {
    color: var(--minigpt-text-tertiary);
    font-weight: 400;
  }

  .header-lang-code {
    padding-inline: 1px;
  }

  .header-lang-toggle:hover,
  .header-lang-toggle:focus-visible {
    color: var(--minigpt-text-primary);
  }



  .minigpt-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--minigpt-radius-md);
    border: 1px solid transparent;
    background: transparent;
    color: var(--minigpt-text-secondary);
    cursor: pointer;
    transition: background-color var(--minigpt-duration-fast) var(--minigpt-ease),
                color var(--minigpt-duration-fast) var(--minigpt-ease),
                border-color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .minigpt-icon-btn:hover {
    background: var(--minigpt-surface-container);
    color: var(--minigpt-text-primary);
    border-color: var(--minigpt-border-subtle);
  }

  .minigpt-icon-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  /* Theme button toggle icon swap */
  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global([data-theme="dark"]) .sun-icon { display: block; }
  :global([data-theme="dark"]) .moon-icon { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun-icon { display: block; }
    :global(:root:not([data-theme="light"])) .moon-icon { display: none; }
  }

  @media (max-width: 1040px) {
    .minigpt-header__subtitle {
      display: none;
    }
    .minigpt-header__nav {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .minigpt-header {
      flex-wrap: wrap;
      padding: var(--minigpt-space-2) var(--minigpt-space-3);
    }
    .minigpt-header__center {
      position: static;
      transform: none;
      order: 3;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      padding-block: 2px;
    }
    .seg {
      padding: 0.3rem 0.65rem;
      font-size: 0.75rem;
    }
  }
</style>
