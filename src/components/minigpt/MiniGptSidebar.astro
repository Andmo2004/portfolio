---
// src/components/minigpt/MiniGptSidebar.astro
interface Props {
  currentLocale: 'es' | 'en';
}

const { currentLocale } = Astro.props;
---

<div id="sidebar-scrim" class="sidebar-scrim" data-open="false" aria-hidden="true"></div>

<aside
  id="minigpt-sidebar"
  class="sidebar"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label={currentLocale === 'en' ? 'Model configuration and architecture' : 'Configuración y arquitectura del modelo'}
  inert
>
  <div class="sidebar__header">
    <div class="sidebar__title-block">
      <h2 class="sidebar__title">
        {currentLocale === 'en' ? 'Model Specs' : 'Parámetros del Modelo'}
      </h2>
      <span class="sidebar__subtitle">miniGPT-v0.1-pre</span>
    </div>

    <button
      type="button"
      id="btn-close-sidebar"
      class="sidebar__close-btn"
      title={currentLocale === 'en' ? 'Close sidebar (Esc)' : 'Cerrar panel (Esc)'}
      aria-label={currentLocale === 'en' ? 'Close sidebar' : 'Cerrar panel'}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="sidebar__content">
    <!-- Arquitectura de Red -->
    <section class="sidebar__section">
      <h3 class="sidebar__section-title">
        {currentLocale === 'en' ? 'Transformer Architecture' : 'Arquitectura del Transformador'}
      </h3>

      <div class="spec-grid">
        <div class="spec-item">
          <span class="spec-item__label">Type</span>
          <span class="spec-item__value">Decoder-only (GPT)</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Parameters</span>
          <span class="spec-item__value font-mono">15,248,640 (~15.2M)</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Layers (n_layer)</span>
          <span class="spec-item__value font-mono">6 Blocks</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Heads (n_head)</span>
          <span class="spec-item__value font-mono">6 (d_k = 64)</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Embedding (n_embd)</span>
          <span class="spec-item__value font-mono">384 dims</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Context (block_size)</span>
          <span class="spec-item__value font-mono">1,024 tokens</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Vocabulary</span>
          <span class="spec-item__value font-mono">50,257 (BPE)</span>
        </div>
        <div class="spec-item">
          <span class="spec-item__label">Normalization</span>
          <span class="spec-item__value">Pre-LayerNorm</span>
        </div>
      </div>
    </section>

    <!-- Parámetros de Inferencia (Interactivos) -->
    <section class="sidebar__section">
      <h3 class="sidebar__section-title">
        {currentLocale === 'en' ? 'Sampling & Generation' : 'Parámetros de Inferencia'}
      </h3>
      <p class="sidebar__section-desc">
        {currentLocale === 'en' 
          ? 'Controls sampling temperature and token limits (prepared for FastAPI inference backend).'
          : 'Controla la temperatura de muestreo y límites de tokens (preparado para el backend FastAPI).'}
      </p>

      <div class="control-group">
        <div class="control-group__header">
          <label for="slider-temp">Temperature</label>
          <span id="val-temp" class="control-group__val">0.70</span>
        </div>
        <input
          type="range"
          id="slider-temp"
          min="0.1"
          max="1.5"
          step="0.05"
          value="0.70"
          class="minigpt-slider"
        />
      </div>

      <div class="control-group">
        <div class="control-group__header">
          <label for="slider-top-p">Top-p (Nucleus)</label>
          <span id="val-top-p" class="control-group__val">0.90</span>
        </div>
        <input
          type="range"
          id="slider-top-p"
          min="0.1"
          max="1.0"
          step="0.05"
          value="0.90"
          class="minigpt-slider"
        />
      </div>

      <div class="control-group">
        <div class="control-group__header">
          <label for="slider-max-tokens">Max Tokens</label>
          <span id="val-max-tokens" class="control-group__val">256</span>
        </div>
        <input
          type="range"
          id="slider-max-tokens"
          min="64"
          max="1024"
          step="64"
          value="256"
          class="minigpt-slider"
        />
      </div>
    </section>

    <!-- Enlaces de Código y Repositorio -->
    <section class="sidebar__section">
      <h3 class="sidebar__section-title">
        {currentLocale === 'en' ? 'Implementation Source' : 'Código Fuente'}
      </h3>
      <div class="source-links">
        <a
          href="https://github.com/Andmo2004"
          target="_blank"
          rel="noopener noreferrer"
          class="source-link-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span>{currentLocale === 'en' ? 'View PyTorch code on GitHub' : 'Ver repositorio PyTorch en GitHub'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</aside>

<script is:inline>
  // Sincronizar sliders de inferencia con sus labels
  function bindSlider(id, valId) {
    const slider = document.getElementById(id);
    const valDisplay = document.getElementById(valId);
    if (slider && valDisplay) {
      slider.addEventListener('input', () => {
        valDisplay.textContent = slider.value;
      });
    }
  }
  bindSlider('slider-temp', 'val-temp');
  bindSlider('slider-top-p', 'val-top-p');
  bindSlider('slider-max-tokens', 'val-max-tokens');
</script>

<style>
  .sidebar-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--minigpt-duration-base) var(--minigpt-ease);
    z-index: 90;
  }

  .sidebar-scrim[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    width: min(340px, 86vw);
    background: var(--minigpt-bg-secondary);
    border-inline-end: 1px solid var(--minigpt-border-default);
    transform: translateX(-100%);
    transition: transform var(--minigpt-duration-slow) var(--minigpt-ease);
    z-index: 100;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
  }

  .sidebar[data-open="true"] {
    transform: translateX(0);
  }

  .sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--minigpt-space-4) var(--minigpt-space-5);
    border-bottom: 1px solid var(--minigpt-border-subtle);
  }

  .sidebar__title {
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-base);
    font-weight: 600;
    color: var(--minigpt-text-primary);
  }

  .sidebar__subtitle {
    display: block;
    font-family: var(--minigpt-font-mono);
    font-size: var(--minigpt-font-xs);
    color: var(--minigpt-text-tertiary);
  }

  .sidebar__close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--minigpt-radius-md);
    background: transparent;
    border: 1px solid transparent;
    color: var(--minigpt-text-secondary);
    cursor: pointer;
    transition: background-color var(--minigpt-duration-fast) var(--minigpt-ease),
                color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .sidebar__close-btn:hover {
    background: var(--minigpt-surface-container);
    color: var(--minigpt-text-primary);
  }

  .sidebar__close-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  .sidebar__content {
    flex: 1;
    overflow-y: auto;
    padding: var(--minigpt-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-6);
  }

  .sidebar__section {
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-3);
  }

  .sidebar__section-title {
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--minigpt-text-tertiary);
  }

  .sidebar__section-desc {
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-xs);
    color: var(--minigpt-text-secondary);
    line-height: var(--minigpt-line-base);
  }

  .spec-grid {
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-2);
    padding: var(--minigpt-space-3);
    border-radius: var(--minigpt-radius-md);
    background: var(--minigpt-surface-container);
    border: 1px solid var(--minigpt-border-subtle);
  }

  .spec-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--minigpt-font-xs);
  }

  .spec-item__label {
    color: var(--minigpt-text-secondary);
  }

  .spec-item__value {
    color: var(--minigpt-text-primary);
    font-weight: 500;
  }

  .font-mono {
    font-family: var(--minigpt-font-mono);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-1);
  }

  .control-group__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--minigpt-font-xs);
    color: var(--minigpt-text-secondary);
  }

  .control-group__val {
    font-family: var(--minigpt-font-mono);
    color: var(--minigpt-accent);
    font-weight: 600;
  }

  .minigpt-slider {
    width: 100%;
    accent-color: var(--minigpt-accent);
    cursor: pointer;
  }

  .source-links {
    margin-top: var(--minigpt-space-1);
  }

  .source-link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--minigpt-space-2);
    padding: var(--minigpt-space-3);
    border-radius: var(--minigpt-radius-md);
    background: var(--minigpt-surface-container);
    border: 1px solid var(--minigpt-border-subtle);
    color: var(--minigpt-text-primary);
    text-decoration: none;
    font-size: var(--minigpt-font-xs);
    font-weight: 500;
    transition: background-color var(--minigpt-duration-fast) var(--minigpt-ease),
                border-color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .source-link-btn:hover {
    background: var(--minigpt-surface-container-high);
    border-color: var(--minigpt-border-default);
  }

  .source-link-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }
</style>
