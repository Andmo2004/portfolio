---
// src/components/minigpt/MiniGptDock.astro
interface Props {
  currentLocale: 'es' | 'en';
}

const { currentLocale } = Astro.props;

const placeholder = currentLocale === 'en'
  ? 'Type a message for miniGPT... (Enter to send, Shift+Enter for newline)'
  : 'Escribe un mensaje para miniGPT... (Enter para enviar, Shift+Enter para salto de línea)';
---

<div class="input-dock-container">
  <div class="input-dock-wrapper">
    <div class="input-dock">
      <!-- Botón Opciones (Abre parámetros) -->
      <button
        type="button"
        id="btn-dock-options"
        class="input-dock__opt-btn"
        title={currentLocale === 'en' ? 'Model options & settings' : 'Opciones y configuración del modelo'}
        aria-label={currentLocale === 'en' ? 'Model options' : 'Opciones del modelo'}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </button>

      <!-- Campo Textarea Auto-expandible -->
      <div class="input-dock__field">
        <textarea
          id="minigpt-input"
          rows="1"
          placeholder={placeholder}
          aria-label={currentLocale === 'en' ? 'Type a prompt for miniGPT' : 'Escribe una consulta para miniGPT'}
        ></textarea>
      </div>

      <!-- Botón de Envío -->
      <button
        type="button"
        id="minigpt-send"
        class="input-dock__send-btn"
        disabled
        title={currentLocale === 'en' ? 'Send message (Enter)' : 'Enviar mensaje (Enter)'}
        aria-label={currentLocale === 'en' ? 'Send message' : 'Enviar mensaje'}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"/>
          <polyline points="5 12 12 5 19 12"/>
        </svg>
      </button>
    </div>

    <!-- Barra de Acciones Secundaria (Clear / New chat) -->
    <div class="input-dock__actions" aria-label="Acciones de conversación">
      <button type="button" id="btn-clear-chat" class="dock-action-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"/>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
        </svg>
        <span>{currentLocale === 'en' ? 'Clear conversation' : 'Limpiar conversación'}</span>
      </button>

      <button type="button" id="btn-new-chat" class="dock-action-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14"/>
          <path d="M5 12h14"/>
        </svg>
        <span>{currentLocale === 'en' ? 'New session' : 'Nueva sesión'}</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  const dockOptBtn = document.getElementById('btn-dock-options');
  if (dockOptBtn) {
    dockOptBtn.addEventListener('click', () => {
      const openBtn = document.getElementById('btn-open-sidebar');
      openBtn?.click();
    });
  }
</script>

<style>
  .input-dock-container {
    position: sticky;
    bottom: 0;
    z-index: 40;
    width: 100%;
    padding-inline: var(--minigpt-space-4);
    padding-top: var(--minigpt-space-2);
    padding-bottom: max(var(--minigpt-space-3), env(safe-area-inset-bottom));
    background: transparent;
    pointer-events: none;
  }

  .input-dock-wrapper {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-2);
    pointer-events: auto;
  }

  .input-dock {
    display: flex;
    align-items: center;
    gap: var(--minigpt-space-2);
    padding: 0.375rem var(--minigpt-space-3);
    border-radius: var(--minigpt-radius-pill);
    background: var(--minigpt-glass-surface);
    backdrop-filter: var(--minigpt-glass-blur);
    -webkit-backdrop-filter: var(--minigpt-glass-blur);
    border: 1px solid var(--minigpt-glass-border);
    box-shadow: var(--minigpt-glass-shadow);
    transition: border-color var(--minigpt-duration-fast) var(--minigpt-ease),
                box-shadow var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .input-dock {
      background: var(--minigpt-surface-container);
    }
  }

  .input-dock:focus-within {
    border-color: var(--minigpt-accent);
    box-shadow: 0 0 0 3px var(--minigpt-accent-subtle), var(--minigpt-glass-shadow);
  }

  .input-dock__opt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: var(--minigpt-text-secondary);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--minigpt-duration-fast) var(--minigpt-ease),
                color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .input-dock__opt-btn:hover {
    background: var(--minigpt-surface-container-high);
    color: var(--minigpt-text-primary);
  }

  .input-dock__opt-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  .input-dock__field {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .input-dock__field textarea {
    width: 100%;
    min-height: 1.5rem;
    max-height: 12.5rem; /* 200px */
    padding: var(--minigpt-space-2) 0;
    resize: none;
    border: none;
    background: transparent;
    color: var(--minigpt-text-primary);
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-base);
    line-height: var(--minigpt-line-base);
    outline: none;
  }

  .input-dock__field textarea::placeholder {
    color: var(--minigpt-text-tertiary);
    font-size: var(--minigpt-font-sm);
  }

  .input-dock__send-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--minigpt-accent);
    color: var(--minigpt-on-accent);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--minigpt-duration-fast) var(--minigpt-ease),
                transform var(--minigpt-duration-fast) var(--minigpt-ease),
                opacity var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .input-dock__send-btn:hover:not(:disabled) {
    background: var(--minigpt-accent-hover);
    transform: scale(1.05);
  }

  .input-dock__send-btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  .input-dock__send-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .input-dock__send-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  .input-dock__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--minigpt-space-4);
    padding-inline: var(--minigpt-space-2);
  }

  .dock-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: var(--minigpt-radius-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--minigpt-text-secondary);
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-xs);
    cursor: pointer;
    transition: color var(--minigpt-duration-fast) var(--minigpt-ease),
                background-color var(--minigpt-duration-fast) var(--minigpt-ease);
  }

  .dock-action-btn:hover {
    color: var(--minigpt-text-primary);
    background: var(--minigpt-surface-container);
  }

  .dock-action-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--minigpt-bg-primary), 0 0 0 4px var(--minigpt-accent);
  }

  @media (max-width: 640px) {
    .input-dock__actions {
      justify-content: space-around;
      gap: var(--minigpt-space-2);
    }
    .input-dock-container {
      padding-inline: var(--minigpt-space-2);
    }
  }
</style>
