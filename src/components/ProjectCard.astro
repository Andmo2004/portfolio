---
// src/components/ProjectCard.astro
import type { ProjectCollaborator } from '../i18n/translations';

interface Props {
  index: number;
  title: string;
  description: string;
  tags: string[];
  href: string;
  exploreLabel?: string;
  badge?: string;
  collaborator?: ProjectCollaborator;
  image?: {
    src: string;
    alt: string;
  };
  isExternal?: boolean;
}

const {
  index,
  title,
  description,
  tags,
  href,
  exploreLabel = 'Explore',
  badge,
  collaborator,
  image,
  isExternal = true,
} = Astro.props;

const isReversed = index % 2 === 1;
---

<article
  class:list={['case-study', { 'case-study--reversed': isReversed }]}
  data-reveal
>
  <span class="case-study__ref">[{index + 1}]</span>

  <div class="case-study__media">
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" />
    ) : (
      <div class="case-study__empty-frame" aria-hidden="true" />
    )}
  </div>

  <div class="case-study__content">
    {badge && <span class="case-study__badge">{badge}</span>}
    
    <h3 class="case-study__title">{title}</h3>

    {collaborator && (
      <div class="case-study__collaborator">
        <span class="case-study__collaborator-label">En colaboración con:</span>
        {collaborator.url ? (
          <a href={collaborator.url} target="_blank" rel="noopener noreferrer" class="case-study__collaborator-link">
            {collaborator.name}
            <span class="case-study__collab-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="case-study__collaborator-name">{collaborator.name}</span>
        )}
      </div>
    )}

    <p class="case-study__description">{description}</p>
    
    <ul class="case-study__tags" aria-label="Tecnologías empleadas">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>

    <a
      href={href}
      class="case-study__link"
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
    >
      <span>{exploreLabel}</span>
      <span class="case-study__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .case-study {
    --reveal-x: 24px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    gap: var(--grid-gutter);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--border);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .case-study--reversed {
    --reveal-x: -24px;
  }

  .case-study__ref {
    grid-column: 1 / 2;
    align-self: start;
    font-family: var(--font-serif);
    font-size: var(--text-small);
    color: var(--fg-subtle);
    padding-top: var(--space-2xs);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study:hover .case-study__ref {
    color: var(--fg);
  }

  .case-study__media {
    grid-column: 2 / 8;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    clip-path: inset(0 0 0 0 round var(--radius-lg));
    box-shadow: 0 4px 20px -8px color-mix(in srgb, var(--fg) 4%, transparent);
    transition: transform var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__media {
    border-color: var(--fg-subtle);
  }

  .case-study__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    transition: transform 700ms var(--ease-out);
  }

  .case-study:hover .case-study__media img {
    transform: scale(1.03);
  }

  .case-study__empty-frame {
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--surface) 60%, var(--bg));
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__empty-frame {
    background: color-mix(in srgb, var(--surface) 80%, var(--bg));
  }

  .case-study__badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2em 0.6em;
    margin-bottom: var(--space-2xs);
    font-family: var(--font-roboto-serif);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--coffee-dark);
    background: var(--coffee-bg);
    border: 1px solid color-mix(in srgb, var(--coffee-dark) 20%, transparent);
    border-radius: var(--radius-xs);
  }

  [data-theme='dark'] .case-study__badge {
    color: #e8d0b5;
    background: rgba(92, 64, 51, 0.25);
    border-color: rgba(232, 208, 181, 0.2);
  }

  .case-study__collaborator {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-roboto-serif);
    font-size: var(--text-caption);
    color: var(--fg-subtle);
    margin-bottom: var(--space-2xs);
  }

  .case-study__collaborator-label {
    font-family: var(--font-roboto-serif);
    color: var(--fg-subtle);
  }

  .case-study__collaborator-name {
    font-family: var(--font-roboto-serif);
    color: var(--fg);
    font-weight: 500;
  }

  .case-study__collaborator-link {
    font-family: var(--font-roboto-serif);
    color: var(--fg);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study__collaborator-link:hover {
    color: var(--coffee-dark);
  }

  .case-study__collab-arrow {
    font-size: 0.85em;
  }

  .case-study__content {
    grid-column: 8 / 13;
  }

  .case-study--reversed .case-study__media {
    grid-column: 6 / 12;
    order: 2;
  }

  .case-study--reversed .case-study__content {
    grid-column: 1 / 6;
    order: 1;
  }

  .case-study--reversed .case-study__ref {
    order: 0;
  }

  .case-study__title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    margin-bottom: var(--space-xs);
  }

  .case-study__description {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--fg-muted);
    max-inline-size: 42ch;
    margin-bottom: var(--space-sm);
  }

  .case-study__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin-bottom: var(--space-md);
  }

  .case-study__tags li {
    padding: 0.28em 0.7em;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--fg-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .case-study:hover .case-study__tags li {
    border-color: var(--fg-subtle);
  }

  .case-study__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study__arrow {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case-study__link:hover .case-study__arrow,
  .case-study__link:focus-visible .case-study__arrow {
    transform: translateX(6px);
  }

  /* Animación reveal */
  .case-study:not(.is-visible) .case-study__media {
    clip-path: inset(0 0 0 100% round var(--radius-lg));
  }

  .case-study:not(.is-visible) .case-study__content {
    opacity: 0;
    transform: translateX(var(--reveal-x));
  }

  .case-study.is-visible .case-study__media,
  .case-study.is-visible .case-study__content {
    transition: clip-path var(--duration-reveal) var(--ease-out),
                opacity var(--duration-reveal) var(--ease-out),
                transform var(--duration-reveal) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study:not(.is-visible) .case-study__media {
      clip-path: none;
    }
    .case-study:not(.is-visible) .case-study__content {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .case-study,
    .case-study--reversed {
      grid-template-columns: 1fr;
      padding-block: var(--space-lg);
    }

    .case-study__ref {
      grid-column: 1 / -1;
      order: 0;
      margin-bottom: var(--space-2xs);
    }

    .case-study__media,
    .case-study--reversed .case-study__media {
      grid-column: 1 / -1;
      order: 1;
      aspect-ratio: 16 / 11;
      margin-bottom: var(--space-sm);
    }

    .case-study__content,
    .case-study--reversed .case-study__content {
      grid-column: 1 / -1;
      order: 2;
    }

    .case-study__description {
      max-inline-size: none;
    }
  }
</style>
