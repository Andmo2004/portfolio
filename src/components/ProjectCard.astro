---
// src/components/ProjectCard.astro
import type { ProjectCollaborator } from '../i18n/translations';

interface Props {
  index: number;
  title: string;
  description: string;
  tags: string[];
  href: string;
  exploreLabel?: string;
  badge?: string;
  collaborator?: ProjectCollaborator;
  image?: {
    src: string;
    alt: string;
  };
  logos?: {
    iconLight: string;
    iconDark: string;
    nameLight?: string;
    nameDark?: string;
    alt: string;
  };
  isExternal?: boolean;
}

const {
  index,
  title,
  description,
  tags,
  href,
  exploreLabel = 'Explore',
  badge,
  collaborator,
  image,
  logos,
  isExternal = true,
} = Astro.props;

const isReversed = index % 2 === 1;
const isEn = href.startsWith('/en');
const isGlasstics = title.toLowerCase().includes('glasstics');
const isMiclustering = title.toLowerCase().includes('miclustering');
const brandTheme = isMiclustering ? 'miclustering' : isGlasstics ? 'glasstics' : 'default';
---

<article
  class:list={['case-study', { 'case-study--reversed': isReversed }]}
  data-reveal
>
  <span class="case-study__ref">[{index + 1}]</span>

  <a
    href={href}
    class="case-study__media"
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    tabindex="-1"
    aria-hidden="true"
  >
    {logos ? (
      <div class:list={['case-study__brand-showcase', `case-study__brand-showcase--${brandTheme}`]}>
        <div class="case-study__brand-grid" aria-hidden="true" />
        <div class="case-study__brand-glow" aria-hidden="true" />
        <div class="case-study__brand-lockup">
          <div class="case-study__brand-icon-wrap">
            <img
              src={logos.iconLight}
              alt={logos.alt}
              class="case-study__brand-icon case-study__theme--light"
              loading="lazy"
            />
            <img
              src={logos.iconDark}
              alt={logos.alt}
              class="case-study__brand-icon case-study__theme--dark"
              loading="lazy"
            />
          </div>
          {(logos.nameLight || logos.nameDark) && (
            <div class="case-study__brand-name-wrap">
              {logos.nameLight && (
                <img
                  src={logos.nameLight}
                  alt={title}
                  class="case-study__brand-name case-study__theme--light"
                  loading="lazy"
                />
              )}
              {logos.nameDark && (
                <img
                  src={logos.nameDark}
                  alt={title}
                  class="case-study__brand-name case-study__theme--dark"
                  loading="lazy"
                />
              )}
            </div>
          )}
        </div>
      </div>
    ) : image ? (
      <img src={image.src} alt={image.alt} loading="lazy" />
    ) : (
      <div class="case-study__empty-frame" aria-hidden="true" />
    )}
  </a>

  <div class="case-study__content">
    {badge && <span class="case-study__badge">{badge}</span>}
    
    <h3 class="case-study__title">{title}</h3>

    {collaborator && (
      <div class="case-study__collaborator">
        <span class="case-study__collaborator-label">
          {isEn ? 'In collaboration with:' : 'En colaboración con:'}
        </span>
        {collaborator.url ? (
          <a href={collaborator.url} target="_blank" rel="noopener noreferrer" class="case-study__collaborator-link">
            {collaborator.name}
            <span class="case-study__collab-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="case-study__collaborator-name">{collaborator.name}</span>
        )}
      </div>
    )}

    <p class="case-study__description">{description}</p>
    
    <ul class="case-study__tags" aria-label={isEn ? 'Technologies used' : 'Tecnologías empleadas'}>
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>

    <a
      href={href}
      class="case-study__link"
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
    >
      <span>{exploreLabel}</span>
      <span class="case-study__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .case-study {
    --reveal-x: 24px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    gap: var(--grid-gutter);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--border);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .case-study--reversed {
    --reveal-x: -24px;
  }

  .case-study__ref {
    grid-column: 1 / 2;
    align-self: start;
    font-family: var(--font-serif);
    font-size: var(--text-small);
    color: var(--fg-subtle);
    padding-top: var(--space-2xs);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study:hover .case-study__ref {
    color: var(--fg);
  }

  .case-study__media {
    display: block;
    text-decoration: none;
    color: inherit;
    grid-column: 2 / 8;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    clip-path: inset(0 0 0 0 round var(--radius-lg));
    box-shadow: 0 4px 20px -8px color-mix(in srgb, var(--fg) 4%, transparent);
    transition: transform var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__media {
    border-color: var(--fg-subtle);
  }

  .case-study__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    transition: transform 700ms var(--ease-out);
  }

  .case-study:hover .case-study__media > img {
    transform: scale(1.03);
  }

  /* Brand Showcase para proyectos con logos (Glasstics, MIClustering) */
  .case-study__brand-showcase {
    --brand-ambient: rgba(95, 145, 243, 0.08);
    --brand-ambient-subtle: rgba(43, 81, 185, 0.02);
    --brand-ambient-dark: rgba(95, 145, 243, 0.16);
    --brand-ambient-dark-subtle: rgba(43, 81, 185, 0.06);
    --brand-glow-1: rgba(95, 145, 243, 0.24);
    --brand-glow-2: rgba(43, 81, 185, 0.08);
    --brand-glow-dark-1: rgba(95, 145, 243, 0.38);
    --brand-glow-dark-2: rgba(43, 81, 185, 0.16);
    --brand-shadow: rgba(43, 81, 185, 0.16);
    --brand-shadow-dark: rgba(95, 145, 243, 0.28);

    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, var(--brand-ambient) 0%, var(--brand-ambient-subtle) 55%, transparent 80%), var(--surface);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  [data-theme='dark'] .case-study__brand-showcase {
    background: radial-gradient(circle at 50% 42%, var(--brand-ambient-dark) 0%, var(--brand-ambient-dark-subtle) 55%, transparent 80%), var(--surface);
  }

  /* Paleta Glasstics (Azul / Observabilidad) */
  .case-study__brand-showcase--glasstics {
    --brand-ambient: rgba(95, 145, 243, 0.08);
    --brand-ambient-subtle: rgba(43, 81, 185, 0.02);
    --brand-ambient-dark: rgba(95, 145, 243, 0.16);
    --brand-ambient-dark-subtle: rgba(43, 81, 185, 0.06);
    --brand-glow-1: rgba(95, 145, 243, 0.24);
    --brand-glow-2: rgba(43, 81, 185, 0.08);
    --brand-glow-dark-1: rgba(95, 145, 243, 0.38);
    --brand-glow-dark-2: rgba(43, 81, 185, 0.16);
    --brand-shadow: rgba(43, 81, 185, 0.16);
    --brand-shadow-dark: rgba(95, 145, 243, 0.28);
  }

  /* Paleta MIClustering (Teal / Sage / Green ML Research) */
  .case-study__brand-showcase--miclustering {
    --brand-ambient: rgba(102, 157, 151, 0.12);
    --brand-ambient-subtle: rgba(101, 161, 108, 0.03);
    --brand-ambient-dark: rgba(102, 157, 151, 0.20);
    --brand-ambient-dark-subtle: rgba(101, 161, 108, 0.08);
    --brand-glow-1: rgba(102, 157, 151, 0.32);
    --brand-glow-2: rgba(101, 161, 108, 0.12);
    --brand-glow-dark-1: rgba(102, 157, 151, 0.44);
    --brand-glow-dark-2: rgba(101, 161, 108, 0.20);
    --brand-shadow: rgba(83, 122, 149, 0.24);
    --brand-shadow-dark: rgba(102, 157, 151, 0.36);
  }

  /* Cuadrícula sutil de ingeniería / observabilidad */
  .case-study__brand-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--fg) 6.5%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: center center;
    opacity: 0.65;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__brand-grid {
    opacity: 0.9;
  }

  /* Resplandor ambiental adaptativo */
  .case-study__brand-glow {
    position: absolute;
    top: 40%;
    left: 50%;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--brand-glow-1) 0%, var(--brand-glow-2) 50%, transparent 70%);
    filter: blur(28px);
    pointer-events: none;
    opacity: 0.75;
    transition: transform var(--duration-base) var(--ease-out),
                opacity var(--duration-base) var(--ease-out),
                filter var(--duration-base) var(--ease-out);
  }

  [data-theme='dark'] .case-study__brand-glow {
    background: radial-gradient(circle, var(--brand-glow-dark-1) 0%, var(--brand-glow-dark-2) 50%, transparent 70%);
    filter: blur(34px);
    opacity: 0.85;
  }

  .case-study:hover .case-study__brand-glow {
    transform: translate(-50%, -50%) scale(1.18);
    opacity: 1;
    filter: blur(32px);
  }

  [data-theme='dark'] .case-study:hover .case-study__brand-glow {
    filter: blur(38px);
  }

  /* Bloque de logo centrado */
  .case-study__brand-lockup {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.3vw, 1.25rem);
    padding: var(--space-md);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__brand-lockup {
    transform: translateY(-4px) scale(1.02);
  }

  /* Icono de marca */
  .case-study__brand-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-study__brand-icon {
    width: clamp(82px, 11vw, 118px);
    height: auto;
    max-height: 118px;
    object-fit: contain;
    filter: drop-shadow(0 6px 20px var(--brand-shadow));
    transition: transform var(--duration-base) var(--ease-out),
                filter var(--duration-base) var(--ease-out);
  }

  [data-theme='dark'] .case-study__brand-icon {
    filter: drop-shadow(0 8px 26px var(--brand-shadow-dark));
  }

  .case-study:hover .case-study__brand-icon {
    transform: translateY(-2px);
  }

  /* Logotipo / Tipografía */
  .case-study__brand-name-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-study__brand-name {
    width: clamp(140px, 18vw, 205px);
    height: auto;
    max-height: 48px;
    object-fit: contain;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__brand-name {
    transform: translateY(-1px);
  }

  /* Conmutación entre Light y Dark */
  .case-study__theme--light {
    display: block;
  }

  .case-study__theme--dark {
    display: none;
  }

  [data-theme='dark'] .case-study__theme--light {
    display: none;
  }

  [data-theme='dark'] .case-study__theme--dark {
    display: block;
  }

  [data-theme='light'] .case-study__theme--light {
    display: block;
  }

  [data-theme='light'] .case-study__theme--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .case-study__theme--light {
      display: none;
    }
    :root:not([data-theme='light']) .case-study__theme--dark {
      display: block;
    }
  }

  .case-study__empty-frame {
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--surface) 60%, var(--bg));
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .case-study:hover .case-study__empty-frame {
    background: color-mix(in srgb, var(--surface) 80%, var(--bg));
  }

  .case-study__badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2em 0.6em;
    margin-bottom: var(--space-2xs);
    font-family: var(--font-roboto-serif);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--coffee-dark);
    background: var(--coffee-bg);
    border: 1px solid color-mix(in srgb, var(--coffee-dark) 20%, transparent);
    border-radius: var(--radius-xs);
  }

  [data-theme='dark'] .case-study__badge {
    color: #e8d0b5;
    background: rgba(92, 64, 51, 0.25);
    border-color: rgba(232, 208, 181, 0.2);
  }

  .case-study__collaborator {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-roboto-serif);
    font-size: var(--text-caption);
    color: var(--fg-subtle);
    margin-bottom: var(--space-2xs);
  }

  .case-study__collaborator-label {
    font-family: var(--font-roboto-serif);
    color: var(--fg-subtle);
  }

  .case-study__collaborator-name {
    font-family: var(--font-roboto-serif);
    color: var(--fg);
    font-weight: 500;
  }

  .case-study__collaborator-link {
    font-family: var(--font-roboto-serif);
    color: var(--fg);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study__collaborator-link:hover {
    color: var(--coffee-dark);
  }

  .case-study__collab-arrow {
    font-size: 0.85em;
  }

  .case-study__content {
    grid-column: 8 / 13;
  }

  .case-study--reversed .case-study__media {
    grid-column: 6 / 12;
    order: 2;
  }

  .case-study--reversed .case-study__content {
    grid-column: 1 / 6;
    order: 1;
  }

  .case-study--reversed .case-study__ref {
    order: 0;
  }

  .case-study__title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    margin-bottom: var(--space-xs);
  }

  .case-study__description {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--fg-muted);
    max-inline-size: 42ch;
    margin-bottom: var(--space-sm);
  }

  .case-study__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin-bottom: var(--space-md);
  }

  .case-study__tags li {
    padding: 0.28em 0.7em;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--fg-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .case-study:hover .case-study__tags li {
    border-color: var(--fg-subtle);
  }

  .case-study__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-study__arrow {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case-study__link:hover .case-study__arrow,
  .case-study__link:focus-visible .case-study__arrow {
    transform: translateX(6px);
  }

  /* Animación reveal */
  .case-study:not(.is-visible) .case-study__media {
    clip-path: inset(0 0 0 100% round var(--radius-lg));
  }

  .case-study:not(.is-visible) .case-study__content {
    opacity: 0;
    transform: translateX(var(--reveal-x));
  }

  .case-study.is-visible .case-study__media,
  .case-study.is-visible .case-study__content {
    transition: clip-path var(--duration-reveal) var(--ease-out),
                opacity var(--duration-reveal) var(--ease-out),
                transform var(--duration-reveal) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study:not(.is-visible) .case-study__media {
      clip-path: none;
    }
    .case-study:not(.is-visible) .case-study__content {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .case-study,
    .case-study--reversed {
      grid-template-columns: 1fr;
      padding-block: var(--space-lg);
    }

    .case-study__ref {
      grid-column: 1 / -1;
      order: 0;
      margin-bottom: var(--space-2xs);
    }

    .case-study__media,
    .case-study--reversed .case-study__media {
      grid-column: 1 / -1;
      order: 1;
      aspect-ratio: 16 / 11;
      margin-bottom: var(--space-sm);
    }

    .case-study__content,
    .case-study--reversed .case-study__content {
      grid-column: 1 / -1;
      order: 2;
    }

    .case-study__description {
      max-inline-size: none;
    }
  }
</style>
