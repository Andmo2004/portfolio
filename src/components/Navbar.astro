---
// src/components/Navbar.astro
import LiveClock from './LiveClock.astro';
import type { Locale, TranslationSchema } from '../i18n/translations';

interface Props {
  currentLocale: Locale;
  t: TranslationSchema;
}

const { currentLocale, t } = Astro.props;

const pathname = Astro.url.pathname;
const isCurrentEn = currentLocale === 'en' || pathname.startsWith('/en');
const esHref = isCurrentEn ? (pathname.replace(/^\/en(?:\/|$)/, '/') || '/') : pathname;
const enHref = isCurrentEn ? pathname : (pathname === '/' ? '/en' : `/en${pathname}`);

const isHome = pathname === '/' || pathname === '/en' || pathname === '/en/';
const homePrefix = isCurrentEn ? '/en' : '';
const getNavHref = (hash: string) => (isHome ? hash : `${homePrefix}/${hash}`);

const navLinks = [
  { label: t.nav.projects, href: getNavHref('#projects') },
  { label: t.nav.tech, href: getNavHref('#tech') },
  { label: t.nav.about, href: getNavHref('#about') },
  { label: t.nav.contact, href: getNavHref('#contact') },
  { label: t.nav.github, href: 'https://github.com/Andmo2004', external: true },
  { label: t.nav.linkedin || 'LinkedIn', href: 'https://www.linkedin.com/in/andrés-moros-rincón-a0247639b', external: true },
];
---

<header class="nav">
  <div class="nav__brand">
    <a href={currentLocale === 'en' ? '/en' : '/'} class="nav__mark">
      {t.nav.mark}
    </a>
  </div>

  <nav class="nav__menu" aria-label={currentLocale === 'en' ? 'Main navigation' : 'Navegación principal'}>
    <ul class="nav__links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="nav__actions">
    <div class="nav__lang-dropdown" id="lang-dropdown">
      <button
        class="nav__lang-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={currentLocale === 'es' ? 'Cambiar idioma' : 'Change language'}
        type="button"
      >
        <span class="nav__lang-bracket" aria-hidden="true">[</span>
        <span class="nav__lang-current">{currentLocale.toUpperCase()}</span>
        <svg class="nav__lang-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
        <span class="nav__lang-bracket" aria-hidden="true">]</span>
      </button>

      <ul class="nav__lang-menu" role="menu">
        <li role="none">
          <a
            href={esHref}
            role="menuitem"
            hreflang="es"
            class:list={['nav__lang-option', { 'is-active': currentLocale === 'es' }]}
            aria-current={currentLocale === 'es' ? 'true' : undefined}
          >
            <span class="nav__lang-option-code">ES</span>
            <span class="nav__lang-option-label">Español</span>
            {currentLocale === 'es' && (
              <svg class="nav__lang-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            )}
          </a>
        </li>
        <li role="none">
          <a
            href={enHref}
            role="menuitem"
            hreflang="en"
            class:list={['nav__lang-option', { 'is-active': currentLocale === 'en' }]}
            aria-current={currentLocale === 'en' ? 'true' : undefined}
          >
            <span class="nav__lang-option-code">EN</span>
            <span class="nav__lang-option-label">English</span>
            {currentLocale === 'en' && (
              <svg class="nav__lang-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            )}
          </a>
        </li>
      </ul>
    </div>

    <LiveClock
      baseTimeZone="Europe/Madrid"
      madridLabel={t.clock.madridLabel}
      visitorLabel={t.clock.visitorLabel}
    />
  </div>
</header>

<script>
  const SEL = '.nav__lang-dropdown';

  function setOpen(dropdown: Element, open: boolean) {
    dropdown.classList.toggle('is-open', open);
    dropdown
      .querySelector('.nav__lang-trigger')
      ?.setAttribute('aria-expanded', String(open));
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const dropdown = target.closest(SEL);

    // Cierra todos los demás menús o todos si se hizo clic fuera
    document.querySelectorAll(`${SEL}.is-open`).forEach((d) => {
      if (d !== dropdown) setOpen(d, false);
    });

    // Toggle solo si se pulsó el botón disparador
    if (dropdown && target.closest('.nav__lang-trigger')) {
      const isOpen = dropdown.classList.contains('is-open');
      setOpen(dropdown, !isOpen);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll(`${SEL}.is-open`).forEach((d) => setOpen(d, false));
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-inline: var(--grid-margin);
    padding-block: var(--space-sm);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  .nav__mark {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lead);
    font-weight: 400;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__mark:hover,
  .nav__mark:focus-visible {
    color: var(--fg-muted);
  }

  .nav__menu {
    display: flex;
    align-items: center;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
  }

  .nav__links a {
    position: relative;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .nav__links a::before,
  .nav__links a::after {
    color: var(--fg-subtle);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out),
                margin var(--duration-fast) var(--ease-out);
    font-family: var(--font-serif);
  }

  .nav__links a::before {
    content: '[';
    margin-right: 0;
  }

  .nav__links a::after {
    content: ']';
    margin-left: 0;
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--fg);
  }

  .nav__links a:hover::before,
  .nav__links a:hover::after,
  .nav__links a:focus-visible::before,
  .nav__links a:focus-visible::after {
    opacity: 1;
  }

  .nav__links a:hover::before,
  .nav__links a:focus-visible::before {
    margin-right: 0.35em;
  }

  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
    margin-left: 0.35em;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* ── Language Dropdown ── */
  .nav__lang-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav__lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-family: var(--font-roboto-serif);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    background: transparent;
    border: none;
    padding: 0.2em 0.3em;
    cursor: pointer;
    user-select: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__lang-trigger:focus-visible {
    outline: 1px solid var(--border);
    border-radius: var(--radius-xs);
  }

  .nav__lang-bracket {
    color: var(--fg-subtle);
    font-family: var(--font-roboto-serif);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav__lang-current {
    font-weight: 600;
  }

  .nav__lang-chevron {
    flex-shrink: 0;
    color: var(--fg-subtle);
    transition: transform var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .nav__lang-trigger:hover,
  .nav__lang-trigger:focus-visible,
  .nav__lang-dropdown.is-open .nav__lang-trigger {
    color: var(--fg);
  }

  .nav__lang-trigger:hover .nav__lang-bracket:first-child,
  .nav__lang-trigger:focus-visible .nav__lang-bracket:first-child,
  .nav__lang-dropdown.is-open .nav__lang-bracket:first-child {
    transform: translateX(-2px);
  }

  .nav__lang-trigger:hover .nav__lang-bracket:last-child,
  .nav__lang-trigger:focus-visible .nav__lang-bracket:last-child,
  .nav__lang-dropdown.is-open .nav__lang-bracket:last-child {
    transform: translateX(2px);
  }

  .nav__lang-trigger:hover .nav__lang-chevron,
  .nav__lang-trigger:focus-visible .nav__lang-chevron,
  .nav__lang-dropdown.is-open .nav__lang-chevron {
    color: var(--fg);
  }

  .nav__lang-dropdown.is-open .nav__lang-chevron {
    transform: rotate(180deg);
  }

  /* Menu */
  .nav__lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 140px;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.12),
                0 2px 6px -1px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.98);
    transition: opacity var(--duration-fast) var(--ease-out),
                visibility var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
    z-index: 50;
  }

  .nav__lang-dropdown.is-open .nav__lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .nav__lang-option {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 0.65em;
    border-radius: var(--radius-xs);
    font-family: var(--font-roboto-serif);
    font-size: var(--text-small);
    color: var(--fg-muted);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .nav__lang-option:hover,
  .nav__lang-option:focus-visible {
    background: var(--surface);
    color: var(--fg);
  }

  .nav__lang-option.is-active {
    color: var(--fg);
    font-weight: 500;
  }

  .nav__lang-option-code {
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-subtle);
    min-width: 1.6em;
  }

  .nav__lang-option.is-active .nav__lang-option-code {
    color: var(--fg);
  }

  .nav__lang-option-label {
    flex: 1;
  }

  .nav__lang-check {
    flex-shrink: 0;
    color: var(--fg);
    margin-left: auto;
  }

  @media (max-width: 860px) {
    .nav__links {
      display: none;
    }
    .nav__actions {
      gap: var(--space-xs);
    }
  }
</style>
