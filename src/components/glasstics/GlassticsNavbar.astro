---
// src/components/glasstics/GlassticsNavbar.astro
interface Props {
  currentLocale: 'es' | 'en';
}

const { currentLocale } = Astro.props;
const isEs = currentLocale === 'es';
const homeHref = isEs ? '/' : '/en';
const langTarget = isEs ? '/en/projects/glasstics' : '/projects/glasstics';
const langLabel = isEs ? 'EN' : 'ES';
---

<header class="glasstics-nav">
  <div class="glasstics-nav__inner">
    <div class="glasstics-nav__left">
      <a href={homeHref} class="glasstics-back-btn">
        <span class="glasstics-back-btn__arrow" aria-hidden="true">←</span>
        <span>{isEs ? 'Volver al portfolio' : 'Back to portfolio'}</span>
      </a>

      <div class="glasstics-nav__sep" aria-hidden="true">/</div>

      <div class="glasstics-brand">
        <div class="glasstics-brand__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="4" />
            <path d="M3 9h18" />
            <path d="M9 21V9" />
          </svg>
        </div>
        <span class="glasstics-brand__name">GLASSTICS</span>
      </div>
    </div>

    <div class="glasstics-nav__right">
      <a href={langTarget} class="glasstics-pill-btn" title={isEs ? 'Switch to English' : 'Cambiar a Español'}>
        <span class="glasstics-pill-btn__code">{langLabel}</span>
      </a>

      <button id="glasstics-theme-toggle" class="glasstics-pill-btn" aria-label="Toggle theme">
        <svg class="theme-icon theme-icon--dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <svg class="theme-icon theme-icon--light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .glasstics-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--card);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--glass-border);
    padding: 0.85rem 1.5rem;
  }

  .glasstics-nav__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .glasstics-nav__left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .glasstics-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: var(--glasstics-radius-sm);
    background: var(--secondary);
    border: 1px solid var(--glass-border);
    transition: all var(--glasstics-duration) var(--glasstics-ease);
  }

  .glasstics-back-btn:hover {
    background: var(--accent);
    transform: translateX(-2px);
  }

  .glasstics-back-btn__arrow {
    font-family: var(--glasstics-font-mono);
    transition: transform var(--glasstics-duration) var(--glasstics-ease);
  }

  .glasstics-back-btn:hover .glasstics-back-btn__arrow {
    transform: translateX(-3px);
  }

  .glasstics-nav__sep {
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  .glasstics-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .glasstics-brand__icon {
    width: 28px;
    height: 28px;
    border-radius: var(--glasstics-radius-xs);
    background: var(--secondary);
    border: 1px solid var(--glass-border);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glasstics-brand__name {
    font-family: var(--glasstics-font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--foreground);
  }

  .glasstics-nav__right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .glasstics-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 0.85rem;
    border-radius: var(--glasstics-radius-sm);
    background: var(--secondary);
    border: 1px solid var(--glass-border);
    color: var(--foreground);
    font-family: var(--glasstics-font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--glasstics-duration) var(--glasstics-ease);
  }

  .glasstics-pill-btn:hover {
    background: var(--accent);
    border-color: var(--primary);
  }

  .theme-icon--light {
    display: none;
  }

  [data-theme='light'] .theme-icon--dark {
    display: none;
  }
  [data-theme='light'] .theme-icon--light {
    display: block;
  }
</style>

<script>
  const toggleBtn = document.getElementById('glasstics-theme-toggle');
  toggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const nextTheme = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    if (nextTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('glasstics_theme', nextTheme);
  });
</script>
