---
interface Props { currentLocale: 'es' | 'en' }
const { currentLocale } = Astro.props;
const isEs = currentLocale === 'es';
const homeHref = isEs ? '/' : '/en';
const langTarget = isEs ? '/en/projects/glasstics' : '/projects/glasstics';
---
<header class="study-bar">
  <a class="brand" href="#resumen" aria-label={isEs ? 'Glasstics, ir al resumen' : 'Glasstics, go to overview'}>
    <img class="brand-icon brand-dark" src="/glasticss/icon-for-dark-theme.svg" alt="" />
    <img class="brand-icon brand-light" src="/glasticss/icon-for-light-theme.svg" alt="" />
    <img class="brand-name brand-dark" src="/glasticss/name-for-dark-theme.svg" alt="Glasstics" />
    <img class="brand-name brand-light" src="/glasticss/name-for-light-theme.svg" alt="Glasstics" />
  </a>
  <div class="bar-actions">
    <a class="bar-back" href={homeHref}><span aria-hidden="true">←</span> {isEs ? 'Portfolio' : 'Portfolio'}</a>
    <a class="bar-language" href={langTarget} aria-label={isEs ? 'Switch to English' : 'Cambiar a español'}>{isEs ? 'EN' : 'ES'}</a>
    <button id="glasstics-theme-toggle" type="button" class="theme-toggle" aria-label={isEs ? 'Cambiar tema claro u oscuro' : 'Toggle light or dark theme'}>
      <svg class="sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42m0-14.14-1.42 1.42M6.35 17.65l-1.42 1.42"/></svg>
      <svg class="moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 0111.2 3a9 9 0 109.8 9.8z"/></svg>
    </button>
  </div>
</header>
<details class="floating-menu" id="study-menu">
  <summary aria-label={isEs ? 'Abrir navegación del caso de estudio' : 'Open case study navigation'}>
    <img class="brand-dark" src="/glasticss/icon-for-dark-theme.svg" alt="" />
    <img class="brand-light" src="/glasticss/icon-for-light-theme.svg" alt="" />
  </summary>
  <nav aria-label={isEs ? 'Secciones del caso de estudio' : 'Case study sections'}>
    <p class="menu-title">{isEs ? 'CASO DE ESTUDIO' : 'CASE STUDY'}</p>
    <a href="#resumen"><span aria-hidden="true">▦</span>{isEs ? 'Resumen' : 'Overview'}</a>
    <a href="#capturas"><span aria-hidden="true">▧</span>{isEs ? 'Capturas' : 'Screenshots'}</a>
    <a href="#arquitectura"><span aria-hidden="true">◇</span>{isEs ? 'Arquitectura' : 'Architecture'}</a>
    <div class="menu-foot">{isEs ? 'PROTOTIPO LOCAL' : 'LOCAL PROTOTYPE'}</div>
  </nav>
</details>
<script>
  const toggleBtn = document.getElementById('glasstics-theme-toggle');
  toggleBtn?.addEventListener('click', () => {
    const nextTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    document.documentElement.classList.toggle('dark', nextTheme === 'dark');
    localStorage.setItem('glasstics_theme', nextTheme);
  });
  const menu = document.querySelector<HTMLDetailsElement>('#study-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
</script>
<style>
.study-bar { min-height:70px; padding:.9rem clamp(1rem,4vw,3rem); display:flex; justify-content:space-between; align-items:center; gap:1rem; border-bottom:1px solid var(--glass-border); }
.brand { display:flex; align-items:center; gap:.65rem; min-width:0; text-decoration:none; }
.brand-icon { width:30px; height:30px; object-fit:contain; }
.brand-name { width:110px; max-height:24px; object-fit:contain; }
.brand-light { display:none; }
:global([data-theme='light']) .brand-dark { display:none; }
:global([data-theme='light']) .brand-light { display:block; }
.bar-actions { display:flex; align-items:center; gap:.55rem; }
.bar-back,.bar-language,.theme-toggle { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; min-height:38px; padding:0 .85rem; color:var(--muted-foreground); background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:12px; font:600 .75rem var(--glasstics-font-sans); text-decoration:none; cursor:pointer; }
.theme-toggle { width:38px; padding:0; } .theme-toggle svg { width:17px; height:17px; }
.bar-back:hover,.bar-language:hover,.theme-toggle:hover { color:var(--foreground); border-color:var(--primary); }
.moon { display:none; } :global([data-theme='light']) .sun { display:none; } :global([data-theme='light']) .moon { display:block; }
.floating-menu { position:fixed; z-index:100; left:20px; bottom:24px; }
.floating-menu summary { list-style:none; width:52px; height:52px; display:grid; place-items:center; border-radius:50%; border:1px solid var(--glass-border); background:var(--glass-bg-thick); box-shadow:var(--glasstics-shadow-card); backdrop-filter:blur(24px); cursor:pointer; }
.floating-menu summary::-webkit-details-marker { display:none; }
.floating-menu summary img { width:29px; height:29px; }
.floating-menu nav { position:absolute; left:0; bottom:64px; width:245px; padding:1rem .75rem; border-radius:20px; background:var(--glass-bg-thick); border:1px solid var(--glass-border); box-shadow:var(--glasstics-shadow-card); backdrop-filter:blur(24px) saturate(150%); }
.menu-title { color:var(--muted-foreground); font-size:.65rem; font-weight:700; letter-spacing:.08em; margin:.3rem .7rem .8rem; }
.floating-menu nav a { display:flex; align-items:center; gap:.85rem; padding:.7rem .75rem; color:var(--muted-foreground); text-decoration:none; border-radius:12px; font-size:.85rem; }
.floating-menu nav a:hover { color:var(--primary); background:var(--secondary); }
.floating-menu nav a span { width:20px; font-size:1rem; text-align:center; }
.menu-foot { color:var(--muted-foreground); border-top:1px solid var(--glass-border); margin:.75rem .2rem 0; padding:.8rem .5rem 0; font-size:.65rem; letter-spacing:.05em; }
a:focus-visible,button:focus-visible,summary:focus-visible { outline:2px solid var(--primary); outline-offset:3px; }
@media(max-width:420px) { .brand-name { width:82px; } .bar-back { padding:0 .55rem; } .bar-actions { gap:.35rem; } .bar-language { padding:0 .65rem; } }
</style>
