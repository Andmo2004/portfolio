---
// src/components/Hero.astro
import type { TranslationSchema } from '../i18n/translations';

interface Props {
  t: TranslationSchema;
}

const { t } = Astro.props;
---

<section class="hero grid" aria-labelledby="hero-title">
  <div class="hero__content">
    <h1 id="hero-title" class="hero__title">
      {t.hero.name}
    </h1>

    <p class="hero__tagline">
      {t.hero.tagline}
    </p>

    <p class="hero__bio">
      {t.hero.bioBrief}
    </p>

    <div class="hero__actions">
      <a href="#projects" class="hero__cta hero__cta--primary">
        <span class="hero__cta-bracket">[</span>
        <span class="hero__cta-label">{t.hero.ctaProjects}</span>
        <span class="hero__cta-bracket">]</span>
      </a>

      <a
        href="https://github.com/Andmo2004"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__cta hero__cta--secondary"
      >
        <span class="hero__cta-bracket">[</span>
        <span class="hero__cta-label">{t.hero.ctaGithub}</span>
        <span class="hero__cta-arrow">↗</span>
        <span class="hero__cta-bracket">]</span>
      </a>

      <a
        href="https://www.linkedin.com/in/andrés-moros-rincón-a0247639b"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__cta hero__cta--secondary"
      >
        <span class="hero__cta-bracket">[</span>
        <span class="hero__cta-label">{t.hero.ctaLinkedin || 'LinkedIn'}</span>
        <span class="hero__cta-arrow">↗</span>
        <span class="hero__cta-bracket">]</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 64px);
    min-height: calc(100dvh - 64px);
    display: grid;
    align-content: center;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .hero__content {
    grid-column: 2 / 12;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 300;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    margin-bottom: var(--space-xs);
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    font-weight: 400;
    color: var(--fg-muted);
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-md);
  }

  .hero__bio {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--fg-muted);
    max-inline-size: 64ch;
    margin-bottom: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__cta-bracket {
    color: var(--fg-subtle);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .hero__cta-label {
    font-weight: 400;
  }

  .hero__cta-arrow {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--fg-subtle);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    color: var(--fg);
  }

  .hero__cta:hover .hero__cta-bracket:first-child,
  .hero__cta:focus-visible .hero__cta-bracket:first-child {
    transform: translateX(-3px);
  }

  .hero__cta:hover .hero__cta-bracket:last-child,
  .hero__cta:focus-visible .hero__cta-bracket:last-child {
    transform: translateX(3px);
  }

  .hero__cta:hover .hero__cta-arrow,
  .hero__cta:focus-visible .hero__cta-arrow {
    transform: translate(2px, -2px);
    color: var(--fg);
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: var(--space-2xl);
      padding-bottom: var(--space-2xl);
    }

    .hero__content {
      grid-column: 1 / -1;
    }
  }
</style>
