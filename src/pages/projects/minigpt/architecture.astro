---
import MiniGptLayout from '../../../layouts/MiniGptLayout.astro';
import MiniGptCaseStudy from '../../../components/minigpt/MiniGptCaseStudy.astro';
const locale = 'es';
const description = locale === 'es' ? 'Caso de estudio de miniGPT: Transformer educativo en PyTorch, entrenamiento y límites.' : 'miniGPT case study: an educational PyTorch Transformer, training and limitations.';
---
<MiniGptLayout title="miniGPT · Caso de estudio | Andrés Moros" description={description} locale={locale} activeTab="architecture">
  <MiniGptCaseStudy currentLocale={locale} />
</MiniGptLayout>
