---
// src/pages/en/projects/minigpt/architecture.astro (English)
import MiniGptLayout from '../../../../layouts/MiniGptLayout.astro';

const locale = 'en';
const metaTitle = 'miniGPT · Architecture | Andrés Moros';
const metaDescription = 'Technical architecture and model topology for miniGPT.';
---

<MiniGptLayout
  title={metaTitle}
  description={metaDescription}
  locale={locale}
  activeTab="architecture"
>
  <div class="static-view">
    <header class="static-view__header">
      <h1 class="static-view__title">Architecture</h1>
      <p class="static-view__subtitle">Technical architecture and model topology for miniGPT.</p>
    </header>

    <div class="static-view__content">
      <!-- Reserved space for user content -->
    </div>
  </div>
</MiniGptLayout>

<style>
  .static-view {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--minigpt-space-6) var(--minigpt-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-4);
    flex: 1;
  }

  .static-view__header {
    display: flex;
    flex-direction: column;
    gap: var(--minigpt-space-1);
  }

  .static-view__title {
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-2xl);
    font-weight: 700;
    color: var(--minigpt-text-primary);
    letter-spacing: -0.02em;
  }

  .static-view__subtitle {
    font-family: var(--minigpt-font-sans);
    font-size: var(--minigpt-font-sm);
    color: var(--minigpt-text-secondary);
  }

  .static-view__content {
    flex: 1;
    min-height: 240px;
    border-radius: var(--minigpt-radius-lg);
    border: 1px dashed var(--minigpt-border-strong);
    background: var(--minigpt-surface-container);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
