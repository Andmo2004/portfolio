---
// src/pages/en/index.astro (English)
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TechStack from '../../components/TechStack.astro';
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { translations } from '../../i18n/translations';

const locale = 'en';
const t = translations[locale];
---

<Layout title={t.meta.title} description={t.meta.description} lang={locale}>
  <Navbar currentLocale={locale} t={t} />

  <main>
    <Hero t={t} />

    <section id="projects" class="projects-section grid" aria-labelledby="projects-title">
      <div class="projects-section__header">
        <span class="projects-section__ref">[{t.projects.sectionRef}]</span>
        <div class="projects-section__title-row">
          <h2 id="projects-title" class="projects-section__title">{t.projects.sectionTitle}</h2>
          <span class="projects-section__notice">[{t.projects.statusNotice}]</span>
        </div>
      </div>

      <div class="projects-section__list">
        {t.projects.items.map((item, index) => (
          <ProjectCard
            index={index}
            title={item.title}
            description={item.description}
            tags={item.tags}
            href={item.href}
            schematicId={item.schematicId}
            schematicTitle={item.schematicTitle}
            codeExcerpt={item.codeExcerpt}
            exploreLabel={t.projects.exploreLabel}
            isExternal={item.isExternal !== undefined ? item.isExternal : true}
          />
        ))}
      </div>
    </section>

    <TechStack t={t} />

    <About t={t} />

    <Contact t={t} />
  </main>

  <Footer t={t} />

  <script>
    import { initScrollReveal } from '../../scripts/reveal';
    initScrollReveal();
  </script>
</Layout>

<style>
  .projects-section {
    padding-block: var(--space-2xl);
  }

  .projects-section__header {
    grid-column: 1 / -1;
    margin-bottom: var(--space-lg);
  }

  .projects-section__ref {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: var(--text-small);
    color: var(--fg-subtle);
    margin-bottom: var(--space-2xs);
  }

  .projects-section__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .projects-section__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
  }

  .projects-section__notice {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide);
  }

  .projects-section__list {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
</style>
