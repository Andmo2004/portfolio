---
// src/pages/en/wip.astro (English)
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { translations } from "../../i18n/translations";

const locale = "en";
const t = translations[locale];
const title = "Work in Progress — Andrés Moros";
const description =
  "This section is currently under active development. Check back soon to see the finished project.";
---

<Layout title={title} description={description} lang={locale}>
  <Navbar currentLocale={locale} t={t} />

  <main class="wip-main">
    <div class="wip-container">
      <!-- Reloj minimalista sin esfera con barras irregulares y radio ampliado -->
      <div class="wip-icon" aria-hidden="true">
        <svg
          class="wip-icon__svg"
          viewBox="0 0 160 160"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- 12 barritas irregulares de las horas (radio exterior amplio, sin esfera) -->
          <g class="wip-clock__markers" fill="currentColor">
            <!-- 12:00 - Rectángulo cardinal superior prominente -->
            <rect
              class="wip-clock__bar wip-clock__bar--12"
              transform="rotate(0 80 80)"
              x="78"
              y="4"
              width="4"
              height="18"
              rx="0.8"
              opacity="0.9"></rect>
            <!-- 01:00 - Corto y delgado -->
            <rect
              class="wip-clock__bar"
              transform="rotate(30 80 80)"
              x="78.9"
              y="12"
              width="2.2"
              height="10"
              rx="0.5"
              opacity="0.4"></rect>
            <!-- 02:00 - Longitud media, ligeramente más ancho -->
            <rect
              class="wip-clock__bar"
              transform="rotate(60 80 80)"
              x="78.4"
              y="8"
              width="3.2"
              height="14"
              rx="0.6"
              opacity="0.55"></rect>
            <!-- 03:00 - Rectángulo cardinal este -->
            <rect
              class="wip-clock__bar wip-clock__bar--3"
              transform="rotate(90 80 80)"
              x="78"
              y="5"
              width="4"
              height="17"
              rx="0.8"
              opacity="0.85"></rect>
            <!-- 04:00 - Compacto y fino -->
            <rect
              class="wip-clock__bar"
              transform="rotate(120 80 80)"
              x="79"
              y="13"
              width="2"
              height="9"
              rx="0.5"
              opacity="0.35"></rect>
            <!-- 05:00 - Estilizado y alargado -->
            <rect
              class="wip-clock__bar"
              transform="rotate(150 80 80)"
              x="78.75"
              y="7"
              width="2.5"
              height="15"
              rx="0.5"
              opacity="0.5"></rect>
            <!-- 06:00 - Rectángulo cardinal sur -->
            <rect
              class="wip-clock__bar wip-clock__bar--6"
              transform="rotate(180 80 80)"
              x="78"
              y="4.5"
              width="4"
              height="17.5"
              rx="0.8"
              opacity="0.85"></rect>
            <!-- 07:00 - Corto y ancho -->
            <rect
              class="wip-clock__bar"
              transform="rotate(210 80 80)"
              x="78.5"
              y="12.5"
              width="3"
              height="9.5"
              rx="0.6"
              opacity="0.4"></rect>
            <!-- 08:00 - Longitud media y fino -->
            <rect
              class="wip-clock__bar"
              transform="rotate(240 80 80)"
              x="78.9"
              y="9"
              width="2.2"
              height="13"
              rx="0.5"
              opacity="0.5"></rect>
            <!-- 09:00 - Rectángulo cardinal oeste -->
            <rect
              class="wip-clock__bar wip-clock__bar--9"
              transform="rotate(270 80 80)"
              x="78"
              y="5"
              width="4"
              height="17"
              rx="0.8"
              opacity="0.85"></rect>
            <!-- 10:00 - Estilizado y alto -->
            <rect
              class="wip-clock__bar"
              transform="rotate(300 80 80)"
              x="79"
              y="6.5"
              width="2"
              height="15.5"
              rx="0.5"
              opacity="0.45"></rect>
            <!-- 11:00 - Proporción equilibrada -->
            <rect
              class="wip-clock__bar"
              transform="rotate(330 80 80)"
              x="78.6"
              y="10.5"
              width="2.8"
              height="11.5"
              rx="0.5"
              opacity="0.5"></rect>
          </g>

          <!-- Aguja central minimalista conservada -->
          <g class="wip-clock__hand">
            <line
              x1="80"
              y1="83"
              x2="80"
              y2="42"
              stroke="var(--fg)"
              stroke-width="1.3"
              stroke-linecap="round"></line>
            <circle cx="80" cy="80" r="2" fill="var(--fg)"></circle>
            <circle cx="80" cy="80" r="0.75" fill="var(--bg)"></circle>
            <animateTransform
              attributeName="transform"
              type="rotate"
              dur="12s"
              repeatCount="indefinite"
              calcMode="discrete"
              values="0 80 80;30 80 80;60 80 80;90 80 80;120 80 80;150 80 80;180 80 80;210 80 80;240 80 80;270 80 80;300 80 80;330 80 80;360 80 80"
              keyTimes="0;0.08333;0.16667;0.25;0.33333;0.41667;0.5;0.58333;0.66667;0.75;0.83333;0.91667;1"
            ></animateTransform>
          </g>
        </svg>
      </div>

      <!--span class="wip-label">[WIP]</span-->

      <h1 class="wip-title">Work in Progress</h1>

      <p class="wip-description">
        This section of the portfolio is under active development. I'm polishing
        the final details to deliver a complete and refined experience.
      </p>

      <div class="wip-meta">
        <div class="wip-meta__item">
          <span class="wip-meta__label">Status</span>
          <span class="wip-meta__value">
            <span class="wip-status-dot" aria-hidden="true"></span>
            Active development
          </span>
        </div>
        <div class="wip-meta__divider" aria-hidden="true"></div>
        <div class="wip-meta__item">
          <span class="wip-meta__label">ETA</span>
          <span class="wip-meta__value">Coming soon</span>
        </div>
      </div>

      <a href="/en" class="wip-back-btn">
        <span class="wip-back-btn__arrow" aria-hidden="true">←</span>
        <span>Return to portfolio</span>
      </a>
    </div>
  </main>

  <Footer t={t} />
</Layout>

<style>
  .wip-main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 200px);
    padding: var(--space-lg) var(--grid-margin);
  }

  .wip-container {
    max-width: 560px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  /* Clock Icon */
  .wip-icon {
    width: clamp(140px, 20vw, 180px);
    height: clamp(140px, 20vw, 180px);
    color: var(--fg-muted);
    margin-bottom: var(--space-xs);
  }

  .wip-icon__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-clock__hand animateTransform {
      display: none;
    }
  }

  /* Label */
  .wip-label {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Title */
  .wip-title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
    margin: 0;
  }

  /* Description */
  .wip-description {
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--fg-muted);
    max-width: 45ch;
    margin: var(--space-3xs) 0 0;
  }

  /* Meta info */
  .wip-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    margin-top: var(--space-xs);
  }

  .wip-meta__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wip-meta__label {
    font-family: var(--font-serif);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--fg-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wip-meta__value {
    font-family: var(--font-serif);
    font-size: var(--text-small);
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .wip-status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: #22c55e;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
    animation: wip-pulse 2s ease-in-out infinite;
  }

  @keyframes wip-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-status-dot {
      animation: none;
    }
  }

  .wip-meta__divider {
    width: 1px;
    height: 2rem;
    background: var(--border);
  }

  /* Back button */
  .wip-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-small);
    color: var(--fg-muted);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .wip-back-btn:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
    transform: translateY(-1px);
  }

  .wip-back-btn__arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .wip-back-btn:hover .wip-back-btn__arrow {
    transform: translateX(-3px);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .wip-meta {
      flex-direction: column;
      gap: var(--space-xs);
      text-align: center;
    }

    .wip-meta__divider {
      width: 3rem;
      height: 1px;
    }

    .wip-meta__item {
      align-items: center;
    }
  }
</style>
