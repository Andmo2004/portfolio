---
// src/layouts/Layout.astro
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  noindex?: boolean;
}

const { title, description, lang = 'es', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/portfolio-icon.svg" />
    <link rel="icon" href="/portfolio-icon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content="Andrés Moros" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Roboto Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,100..900;1,8..144,100..900&display=swap" rel="stylesheet" />

    <!-- Detección instantánea de tema según preferencia del sistema (sin parpadeo) -->
    <script is:inline>
      (function () {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        function updateTheme(mediaQuery) {
          const theme = mediaQuery.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        }
        updateTheme(prefersDark);
        try {
          prefersDark.addEventListener('change', updateTheme);
        } catch (e) {
          prefersDark.addListener(updateTheme);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
